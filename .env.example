# AI provider: ollama (local) or openrouter
AI_PROVIDER=ollama
OLLAMA_MODEL=gemma4:26b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=replace-with-your-openrouter-key

# Speech languages: "all" enables the catalog, or list codes like de,en,pl
LANGUAGES=all
DEFAULT_LANGUAGE=de
AUTO_LANGUAGE_SWITCH=true
AUTO_INSTALL_ASSETS=true
FAST_MODE=true
LISTEN_TIMEOUT=12
LISTEN_PHRASE_LIMIT=8

# Optional local model path overrides. Defaults are derived from the language catalog.
# VOSK_MODEL_PATH_DE=models/vosk-model-small-de-0.15
# PIPER_MODEL_PATH_DE=voices/de_DE-thorsten-medium.onnx

# Optional integrations. Fill these only when using the integration.
HA_URL=http://home-assistant.local:8123/api
BEARER_TOKEN=
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD=
